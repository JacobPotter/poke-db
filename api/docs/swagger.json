{
    "swagger": "2.0",
    "info": {
        "description": "Pokemon Database API.",
        "title": "PokeDB API",
        "contact": {
            "name": "Jacob Potter",
            "email": "pttr.jcb@gmail.com"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/healthz": {
            "get": {
                "description": "Returns the health status of the API service",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.HealthResponse"
                        }
                    }
                }
            }
        },
        "/pokemon": {
            "get": {
                "description": "List Pokemon",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pokemon"
                ],
                "summary": "List Pokemon",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.ListPokemonResponse"
                        }
                    }
                }
            }
        },
        "/pokemon/{id}": {
            "get": {
                "description": "Get pokemon by GenericId",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pokemon"
                ],
                "summary": "Get Pokemon",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Pokemon GenericId",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Pokemon"
                        }
                    }
                }
            }
        },
        "/type": {
            "get": {
                "description": "List Types",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "type"
                ],
                "summary": "List Types",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.MoveType"
                            }
                        }
                    }
                }
            }
        },
        "/type/{id}": {
            "get": {
                "description": "Get type by GenericId",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "type"
                ],
                "summary": "Get MoveType",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "MoveType GenericId",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.MoveType"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "models.ListPokemonParams": {
            "type": "object",
            "properties": {
                "pokemonName": {
                    "type": "string"
                },
                "pokemonTypeId": {
                    "type": "integer"
                }
            }
        },
        "models.ListPokemonResponse": {
            "type": "object",
            "properties": {
                "nextPage": {
                    "type": "string"
                },
                "page": {
                    "type": "integer"
                },
                "pageSize": {
                    "type": "integer"
                },
                "params": {
                    "$ref": "#/definitions/models.ListPokemonParams"
                },
                "pokemon": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.PokemonSpecies"
                    }
                },
                "prevPage": {
                    "type": "string"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "models.Move": {
            "type": "object",
            "properties": {
                "accuracy": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "learnedByPokemon": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Pokemon"
                    }
                },
                "moveType": {
                    "$ref": "#/definitions/models.MoveType"
                },
                "moveTypeID": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "power": {
                    "type": "integer"
                },
                "pp": {
                    "type": "integer"
                },
                "priority": {
                    "type": "integer"
                }
            }
        },
        "models.MoveType": {
            "type": "object",
            "properties": {
                "double_damage_from": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "double_damage_to": {
                    "description": "TODO: convert to manytomany table somehow",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "half_damage_from": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "half_damage_to": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "id": {
                    "type": "integer"
                },
                "img_url": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "no_damage_from": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "no_damage_to": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                }
            }
        },
        "models.Pokemon": {
            "type": "object",
            "properties": {
                "cry": {
                    "type": "string"
                },
                "height": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "is_default": {
                    "type": "boolean"
                },
                "learnable_moves": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Move"
                    }
                },
                "name": {
                    "type": "string"
                },
                "pokemon_species": {
                    "$ref": "#/definitions/models.PokemonSpecies"
                },
                "pokemon_species_id": {
                    "type": "integer"
                },
                "primary_type": {
                    "$ref": "#/definitions/models.MoveType"
                },
                "primary_type_id": {
                    "type": "integer"
                },
                "secondary_type": {
                    "$ref": "#/definitions/models.MoveType"
                },
                "secondary_type_id": {
                    "type": "integer"
                },
                "sprite_url": {
                    "type": "string"
                },
                "weight": {
                    "type": "integer"
                }
            }
        },
        "models.PokemonSpecies": {
            "type": "object",
            "properties": {
                "has_gender_differences": {
                    "type": "boolean"
                },
                "hatch_counter": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "is_baby": {
                    "type": "boolean"
                },
                "is_legendary": {
                    "type": "boolean"
                },
                "is_mythical": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "varieties": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.Pokemon"
                    }
                }
            }
        }
    }
}